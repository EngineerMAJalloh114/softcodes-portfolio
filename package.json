{
  "name": "softcodes-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:verify": "tsx --conditions=react-server scripts/verify-t2.ts",
    "auth:create-owner": "tsx scripts/create-owner.ts",
    "auth:verify": "tsx scripts/verify-t3.ts",
    "test": "tsx --test tests/*.test.ts",
    "admin:verify": "tsx --conditions=react-server scripts/verify-t4.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/s3-request-presigner": "^3.1172.0",
    "@neon/config": "^1.14.4",
    "@neon/env": "^2.1.7",
    "@neondatabase/serverless": "^1.2.1",
    "@smithy/node-http-handler": "^4.14.2",
    "@vercel/functions": "^3.11.3",
    "better-auth": "^1.7.26",
    "drizzle-orm": "^0.45.4",
    "https-proxy-agent": "^9.1.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
